<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header', { user: user, family: family, notifications: notifications }) %>
  <main class="dashboard-page child-dashboard">
    <div class="dashboard-container">
      <main class="main-content child-main">
        <% if (messages && messages.length > 0) { %>
          <% messages.forEach(function(msg) { %>
            <div class="alert alert-<%= msg.type %> toast">
              <svg class="alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <% if (msg.type === 'success') { %>
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                <% } else if (msg.type === 'error') { %>
                  <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
                <% } else { %>
                  <circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>
                <% } %>
              </svg>
              <span><%= msg.text %></span>
              <button class="alert-close">&times;</button>
            </div>
          <% }); %>
        <% } %>

        <% if (!family) { %>
          <!-- Not in a family -->
          <div class="empty-state join-family">
            <div class="empty-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
              </svg>
            </div>
            <h2>Join Your Family</h2>
            <p>Ask your parent for the invitation code to join the family and start managing your pocket money.</p>
            <form method="POST" action="/child/family/join" class="empty-form">
              <div class="input-wrapper">
                <input type="text" name="invitationCode" placeholder="Enter Invitation Code (e.g., ABC123XY)" required style="text-transform: uppercase;">
              </div>
              <button type="submit" class="btn btn-primary">Join Family</button>
            </form>
          </div>
        <% } else { %>
          <!-- Balance Card -->
          <div class="balance-card">
            <div class="balance-header">
              <div>
                <span class="balance-label">Available Balance</span>
                <h1 class="balance-amount">₹<%= stats.balance.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></h1>
              </div>
              <% if (stats.isFrozen) { %>
                <span class="frozen-badge large">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="9" width="20" height="6" rx="1"/>
                    <path d="M10 9V5a2 2 0 0 1 2-2h0a2 2 0 0 1 2 2v4"/>
                  </svg>
                  Wallet Frozen
                </span>
              <% } %>
            </div>
            <div class="balance-stats">
              <div class="balance-stat">
                <span class="stat-value income">+₹<%= stats.totalReceived.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></span>
                <span class="stat-label">Total Received</span>
              </div>
              <div class="balance-stat">
                <span class="stat-value expense">-₹<%= stats.totalSpent.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></span>
                <span class="stat-label">Total Spent</span>
              </div>
              <div class="balance-stat">
                <span class="stat-value"><%= stats.spendingLimit ? '₹' + stats.spendingLimit.toLocaleString('en-IN') + '/mo' : 'No limit' %></span>
                <span class="stat-label">Monthly Limit</span>
              </div>
            </div>
          </div>

          <!-- Quick Actions -->
          <div class="section-header">
            <h2>Quick Actions</h2>
          </div>
          <div class="quick-actions child-actions">
            <button class="action-btn" data-modal="requestMoneyModal" <% if (stats.isFrozen) { %>disabled<% } %>>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
              </svg>
              <span>Request Money</span>
            </button>
            <button class="action-btn" data-modal="requestWithdrawalModal" <% if (stats.isFrozen) { %>disabled<% } %>>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 12V7H5V7M3 12h18M7 17h10M12 7v10"/>
              </svg>
              <span>Request Withdrawal</span>
            </button>
            <button class="action-btn" data-modal="createGoalModal">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
              </svg>
              <span>Create Savings Goal</span>
            </button>
            <a href="/child/transactions" class="action-btn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="1" x2="12" y2="23"/>
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
              </svg>
              <span>View Transactions</span>
            </a>
          </div>

          <!-- Savings Goals -->
          <div class="section-header with-action">
            <h2>Savings Goals</h2>
            <button class="btn btn-primary btn-sm" data-modal="createGoalModal">Add Goal</button>
          </div>

          <% if (stats.savingsGoals && stats.savingsGoals.length > 0) { %>
            <div class="goals-grid">
              <% stats.savingsGoals.forEach(function(goal) { %>
                <article class="goal-card">
                  <div class="goal-header">
                    <h3><%= goal.title %></h3>
                    <span class="goal-percentage"><%= Math.round((goal.current_amount / goal.target_amount) * 100) %>%</span>
                  </div>
                  <div class="goal-progress">
                    <div class="progress-bar">
                      <div class="progress-fill" style="width: <%= Math.min(100, (goal.current_amount / goal.target_amount) * 100) %>%"></div>
                    </div>
                    <div class="goal-amounts">
                      <span>₹<%= goal.current_amount.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></span>
                      <span>/</span>
                      <span>₹<%= goal.target_amount.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></span>
                    </div>
                  </div>
                  <% if (goal.description) { %>
                    <p class="goal-description"><%= goal.description %></p>
                  <% } %>
                  <% if (goal.target_date) { %>
                    <p class="goal-target-date">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                        <line x1="16" y1="2" x2="16" y2="6"/>
                        <line x1="8" y1="2" x2="8" y2="6"/>
                        <line x1="3" y1="10" x2="21" y2="10"/>
                      </svg>
                      Target: <%= new Date(goal.target_date).toLocaleDateString('en-IN', {day: '2-digit', month: 'short', year: 'numeric'}) %>
                    </p>
                  <% } %>
                  <form method="POST" action="/child/savings/add" class="goal-form">
                    <input type="hidden" name="goalId" value="<%= goal.id %>">
                    <div class="form-row">
                      <div class="form-group flex-1">
                        <label for="saveAmount_<%= goal.id %>">Add to Savings (₹)</label>
                        <input type="number" name="amount" id="saveAmount_<%= goal.id %>" placeholder="0.00" step="0.01" min="1" required>
                      </div>
                      <button type="submit" class="btn btn-primary" <%= stats.isFrozen ? 'disabled' : '' %>>Save</button>
                    </div>
                  </form>
                </article>
              <% }); %>
            </div>
          <% } else { %>
            <div class="empty-state small">
              <div class="empty-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                </svg>
              </div>
              <h3>No Savings Goals Yet</h3>
              <p>Create a savings goal to start saving for something special!</p>
              <button class="btn btn-primary" data-modal="createGoalModal">Create Your First Goal</button>
            </div>
          <% } %>

          <!-- Pending Requests -->
          <% if (stats.pendingRequests && stats.pendingRequests.length > 0) { %>
            <div class="section-header">
              <h2>Pending Requests</h2>
            </div>
            <div class="requests-list">
              <% stats.pendingRequests.forEach(function(request) { %>
                <article class="request-card">
                  <div class="request-info">
                    <div class="request-icon warning">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                        <line x1="12" y1="9" x2="12" y2="13"/>
                        <line x1="12" y1="17" x2="12.01" y2="17"/>
                      </svg>
                    </div>
                    <div class="request-details">
                      <h4>Withdrawal Request</h4>
                      <p>₹<%= request.amount.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> <%= request.description ? '- ' + request.description : '' %></p>
                      <span class="request-date">Requested: <%= new Date(request.requested_at).toLocaleDateString('en-IN', {day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit'}) %></span>
                    </div>
                  </div>
                  <span class="status status-pending">Pending Approval</span>
                </article>
              <% }); %>
            </div>
          <% } %>

          <!-- Recent Transactions -->
          <div class="section-header with-action">
            <h2>Recent Transactions</h2>
            <a href="/child/transactions" class="btn btn-ghost btn-sm">View All</a>
          </div>
          <div class="table-container">
            <table class="transactions-table">
              <thead>
                <tr>
                  <th>Type</th>
                  <th>Amount</th>
                  <th>Description</th>
                  <th>Date</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% if (stats.recentTransactions && stats.recentTransactions.length > 0) { %>
                  <% stats.recentTransactions.forEach(function(tx) { %>
                    <tr>
                      <td>
                        <span class="tx-type tx-<%= tx.type %>">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="tx-icon">
                            <% if (tx.type === 'deposit') { %>
                              <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                            <% } else if (tx.type === 'withdrawal') { %>
                              <path d="M21 12V7H5V7M3 12h18M7 17h10M12 7v10"/>
                            <% } else if (tx.type === 'deduction') { %>
                              <line x1="5" y1="12" x2="19" y2="12"/>
                            <% } else if (tx.type === 'savings') { %>
                              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                            <% } else { %>
                              <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
                            <% } %>
                          </svg>
                          <%= tx.type.charAt(0).toUpperCase() + tx.type.slice(1) %>
                        </span>
                      </td>
                      <td class="<%= tx.type === 'deposit' ? 'income' : 'expense' %>">
                        <%= tx.type === 'deposit' ? '+' : '-' %>₹<%= tx.amount.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %>
                      </td>
                      <td><%= tx.description || '-' %></td>
                      <td><%= new Date(tx.created_at).toLocaleDateString('en-IN', {day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit'}) %></td>
                      <td><span class="status status-<%= tx.status %>"><%= tx.status.charAt(0).toUpperCase() + tx.status.slice(1) %></span></td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="5" class="empty-table">No transactions yet</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        <% } %>
      </main>
    </div>

    <!-- Modals -->
    <div class="modal-overlay" id="requestMoneyModal">
      <div class="modal">
        <div class="modal-header">
          <h3>Request Money</h3>
          <button class="modal-close">&times;</button>
        </div>
        <form method="POST" action="/child/money/request" class="modal-form">
          <div class="form-group">
            <label for="reqAmount">Amount (₹)</label>
            <input type="number" name="amount" id="reqAmount" placeholder="0.00" step="0.01" min="1" required>
          </div>
          <div class="form-group">
            <label for="reqDescription">Description (optional)</label>
            <input type="text" name="description" id="reqDescription" placeholder="e.g., School trip, New book">
          </div>
          <div class="modal-actions">
            <button type="button" class="btn btn-secondary modal-close">Cancel</button>
            <button type="submit" class="btn btn-primary">Send Request</button>
          </div>
        </form>
      </div>
    </div>

    <div class="modal-overlay" id="requestWithdrawalModal">
      <div class="modal">
        <div class="modal-header">
          <h3>Request Withdrawal</h3>
          <button class="modal-close">&times;</button>
        </div>
        <form method="POST" action="/child/withdrawal/request" class="modal-form">
          <div class="form-group">
            <label for="wdAmount">Amount (₹)</label>
            <input type="number" name="amount" id="wdAmount" placeholder="0.00" step="0.01" min="1" max="<%= stats.balance %>" required>
            <span class="form-hint">Available: ₹<%= stats.balance.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></span>
          </div>
          <div class="form-group">
            <label for="wdDescription">Description (optional)</label>
            <input type="text" name="description" id="wdDescription" placeholder="e.g., Buy new game, Save for later">
          </div>
          <div class="modal-actions">
            <button type="button" class="btn btn-secondary modal-close">Cancel</button>
            <button type="submit" class="btn btn-primary">Request Withdrawal</button>
          </div>
        </form>
      </div>
    </div>

    <div class="modal-overlay" id="createGoalModal">
      <div class="modal">
        <div class="modal-header">
          <h3>Create Savings Goal</h3>
          <button class="modal-close">&times;</button>
        </div>
        <form method="POST" action="/child/savings/create" class="modal-form">
          <div class="form-group">
            <label for="goalTitle">Goal Title</label>
            <input type="text" name="title" id="goalTitle" placeholder="e.g., New Bicycle, Gaming Console" required>
          </div>
          <div class="form-group">
            <label for="goalTarget">Target Amount (₹)</label>
            <input type="number" name="targetAmount" id="goalTarget" placeholder="0.00" step="0.01" min="1" required>
          </div>
          <div class="form-group">
            <label for="goalDescription">Description (optional)</label>
            <textarea name="description" id="goalDescription" placeholder="What are you saving for?" rows="3"></textarea>
          </div>
          <div class="form-group">
            <label for="goalTargetDate">Target Date (optional)</label>
            <input type="date" name="targetDate" id="goalTargetDate">
          </div>
          <div class="modal-actions">
            <button type="button" class="btn btn-secondary modal-close">Cancel</button>
            <button type="submit" class="btn btn-primary">Create Goal</button>
          </div>
        </form>
      </div>
    </div>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>